* text=auto

*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf

# Canonical content checksums are byte-for-byte reproducible on Linux and
# Windows. Binary media rules below override the content-wide LF policy.
content/** text eol=lf
content/**/*.png binary
content/**/*.jpg binary
content/**/*.jpeg binary
content/**/*.gif binary
content/**/*.webp binary

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.zip binary
