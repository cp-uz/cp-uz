DJANGO_SETTINGS_MODULE=core.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
LOG_LEVEL=INFO
GUEST_SESSION_THROTTLE=20/hour
GUEST_UPGRADE_THROTTLE=5/hour
FEEDBACK_THROTTLE=5/hour
TELEGRAM_BOT_TOKEN=
TELEGRAM_FEEDBACK_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PROXY_URL=
TELEGRAM_API_TIMEOUT_SECONDS=15
DISCORD_INVITE_URL_ENCRYPTED=

# Production examples
# DJANGO_SETTINGS_MODULE=core.settings.production
# DATABASE_URL=sqlite:////app/data/db.sqlite3
# REDIS_URL=redis://redis:6379/1
# SECURE_SSL_REDIRECT=true
