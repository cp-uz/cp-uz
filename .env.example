# Copy to .env on the production host and replace every CHANGE_ME value.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=CHANGE_ME_generate_a_long_random_value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=cp.uz,www.cp.uz,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://cp.uz,https://www.cp.uz
DJANGO_CORS_ALLOWED_ORIGINS=https://cp.uz,https://www.cp.uz
SITE_URL=https://cp.uz
# TLS termination and HTTP→HTTPS redirect are handled by the host Nginx.
SECURE_SSL_REDIRECT=false

DATABASE_URL=sqlite:////app/data/db.sqlite3
REDIS_URL=redis://redis:6379/1

# Optional. Keep credentials only in the root-owned production .env file.
# Docker treats HTTP_PROXY/HTTPS_PROXY as predefined build arguments and does
# not persist them in image history when the Dockerfile does not declare them.
NPM_PROXY_URL=

CPUZ_BIND_ADDRESS=127.0.0.1
CPUZ_HTTP_PORT=18181
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=90

# Telegram feedback integration. Keep all three values secret in production.
TELEGRAM_BOT_TOKEN=
TELEGRAM_FEEDBACK_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PROXY_URL=
TELEGRAM_API_TIMEOUT_SECONDS=15
FEEDBACK_THROTTLE=5/hour
LOGIN_THROTTLE=5/min
LOGIN_IP_THROTTLE=30/min

# Generate after DJANGO_SECRET_KEY is set:
# docker compose run --rm web python manage.py encrypt_discord_invite
DISCORD_INVITE_URL_ENCRYPTED=CHANGE_ME_generate_with_encrypt_discord_invite

# Create the first admin with: docker compose exec web python manage.py createsuperuser
